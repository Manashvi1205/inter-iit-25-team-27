<?xml version="1.0"?>
<robot xmlns="http://www.ros.org/wiki/xacro">
  <gazebo reference="caster_wheel_link">
    <mu1 value="0.1" />
    <mu2 value="0.1" />
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu">
    </plugin>

    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
    </plugin>
  </gazebo>

  
  
  <gazebo>
    <plugin filename="libignition-gazebo6-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <!-- wheel joint names -->
      <left_joint>base_left_wheel_joint</left_joint>
      <right_joint>base_right_wheel_joint</right_joint>

      <!-- physical parameters (edit or convert to xacro properties if needed) -->
      <wheel_separation>0.4</wheel_separation>
      <wheel_radius>0.1</wheel_radius>

      <!-- topic names -->
      <!-- <cmd_vel_topic>/cmd_vel</cmd_vel_topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic> -->

      <!-- frames -->
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>

      <!-- publishing / behaviour -->
      <!-- <odom_publish_frequency>30</odom_publish_frequency>
      <publish_rate>50</publish_rate> -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

      <!-- optional tuning -->
      <wheel_torque>5.0</wheel_torque>
    </plugin>
  </gazebo>

  <!-- GPU/LiDAR sensor block preserved -->
  <gazebo reference="laser">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <pose> 0 0 0 0 0 0</pose>
      <topic>my_robot/scan</topic>
      <update_rate>10</update_rate>
      <ignition_frame_id>laser</ignition_frame_id>
      <lidar>
          <scan>
              <horizontal>
                  <samples>1800</samples>
                  <resolution>1</resolution>
                  <min_angle>-3.14</min_angle>
                  <max_angle>3.14</max_angle>
              </horizontal>
          </scan>
          <range>
              <min>0.30</min>
              <max>30.0</max>
              <resolution>0.01</resolution>
          </range>
          <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.001</stddev>
          </noise>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
