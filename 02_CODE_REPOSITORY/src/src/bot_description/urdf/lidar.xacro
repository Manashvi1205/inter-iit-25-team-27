<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >


    <link name="laser">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </collision>
        <!-- <xacro:cylinder_inertia m="0.1" l="0.04" r="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:cylinder_inertia> -->
        <xacro:cylinder_inertia m=".1" r="${wheel_radius}" l="${wheel_length}"
        o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
    </link>

    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser"/>
        <origin xyz="0 0 ${base_height+0.0125}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>


    <gazebo reference="laser">
        <material name="white">
            <color rgba="1.0 1.0 1.0 1.0"/>
        </material>
        
    </gazebo>

</robot>