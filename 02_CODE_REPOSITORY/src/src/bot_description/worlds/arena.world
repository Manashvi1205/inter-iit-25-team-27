<?xml version="1.0"?>
<sdf version="1.7">
  <world name="my_arena_world">

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="arena_static">
      <pose>0 0 0.01 1.5708 0 0 </pose>
      <static>true</static>
      <link name="arena_link">

        <visual name="visual">
          <geometry>
            <mesh>
              <uri>meshes/full_arena.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>

          <!-- Added green material -->
          <material>
            <ambient>0.0 0.6 0.0 1</ambient>
            <diffuse>0.0 0.8 0.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>

        </visual>

        <collision name="collision">
          <geometry>
            <mesh>
              <uri>meshes/full_arena.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
        </collision>

      </link>
    </model>


  </world>
</sdf>
